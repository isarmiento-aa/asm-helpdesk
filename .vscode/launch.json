{
    // Press F5 (or Run and Debug > "Run Helpdesk") to start the local server and open Chrome.
    // Use "localhost", not 127.0.0.1: Google sign-in only allows localhost by default.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Helpdesk server",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/.vscode/serve.js",
            "console": "integratedTerminal"
        },
        {
            "name": "Chrome: helpdesk",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}/public"
        }
    ],
    "compounds": [
        {
            "name": "Run Helpdesk",
            "configurations": ["Helpdesk server", "Chrome: helpdesk"],
            "stopAll": true
        }
    ]
}
